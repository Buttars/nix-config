/* Design layer. Colours and font come from colors.rasi, which nix generates
 * from the stylix palette — do not hardcode either here. */

@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg0;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    location:         center;
    width:            600;
    border-radius:    16px;
    border:           2px;
    border-color:     @bg2;
    background-color: @bg0;
}

mainbox {
    padding: 16px;
    spacing: 12px;
}

inputbar {
    background-color: @bg1;
    border-radius:    12px;
    padding:          12px 16px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:     @bg3;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search";
    placeholder-color: @fg3;
    vertical-align:    0.5;
}

listview {
    background-color: transparent;
    lines:            8;
    columns:          1;
    fixed-height:     false;
    scrollbar:        false;
    spacing:          2px;
}

element {
    padding:       10px 12px;
    spacing:       12px;
    border-radius: 10px;
}

element normal active {
    text-color: @bg3;
}

/* A left accent bar on the selected row reads more deliberately than
 * flooding the whole row with the accent colour. */
element selected normal,
element selected active {
    background-color: @bg1;
    text-color:       @fg0;
    border:           0px 0px 0px 3px;
    border-color:     @bg3;
}

element-icon {
    size:           1.8em;
    vertical-align: 0.5;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

message {
    border-radius:    12px;
    background-color: @bg1;
}

textbox {
    padding: 10px 16px;
}
